# ==========================================
# Rotpunkt Translate - Environment Variables
# ==========================================

# -----------------
# Core Application
# -----------------
APP_NAME="Rotpunkt Translate"

# Security (JWT Authentication)
SECRET_KEY="change_me_in_production_extremely_long_and_secure_random_string"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# The connection string to your PostgreSQL database.
# For local development with docker-compose:
DATABASE_URL="postgresql+asyncpg://rotpunkt:rotpunkt@localhost:5433/rotpunkt"

# Comma-separated list of allowed frontend origins
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# Directory where uploaded PDFs will be temporarily stored
UPLOAD_DIR="storage/uploads"

# -----------------
# Translation Engines
# -----------------
# Choose which translation engine to use. 
# Options: "mock" (for testing/CI), "gemini" (LLM), or "deepl" (Standard Translation)
TRANSLATION_PROVIDER="mock"

# Required if TRANSLATION_PROVIDER="deepl"
DEEPL_API_KEY=""

# Required if TRANSLATION_PROVIDER="gemini"
GEMINI_API_KEY=""

# Required for JEV model testing (F3-F5 highlighting)
OPENROUTER_API_KEY=""
