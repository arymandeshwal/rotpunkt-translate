# Docker Compose reads this file as .env in the repo root.
# Host port for the API. Change it if 8000 is taken (e.g. Windows/Hyper-V reserves 7681-8680).
BACKEND_PORT=8000

# Copy to backend/.env for local (non-Docker) development.
DATABASE_URL=postgresql+asyncpg://rotpunkt:rotpunkt@localhost:5433/rotpunkt
